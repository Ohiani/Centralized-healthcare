# API Base URL for the backend
# Change this to your production URL when deploying (full origin, e.g. http://1.2.3.4)
VITE_API_URL=http://localhost:3001

# AI recommendations now run through the backend (POST /api/ai/recommendations).
# Configure the AI provider (Ollama / OpenAI / mock) in Backend/.env, not here.

# Hospital API keys for the /hospital-a and /hospital-b demo portals.
# Get them by running "npm run seed" in Backend (or register the hospital in the
# admin dashboard). A real hospital would keep its key on its own server.
VITE_HOSPITAL_A_API_KEY=
VITE_HOSPITAL_B_API_KEY=
