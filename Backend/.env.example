# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string. Include the database name (here "chrs") before the "?".
# Atlas: Database > Connect > Drivers. Also add your IP under Network Access.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/chrs?retryWrites=true&w=majority

# Secret used to sign login tokens. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Port the API listens on
PORT=3001

# --- AI recommendations (POST /api/ai/recommendations) ---
# ollama = free local model (install Ollama and run: ollama pull llama3.2:3b)
# openai = OpenAI API (paid, needs OPENAI_API_KEY)
# mock   = fixed fake answer, for demos without any AI running
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Only needed when AI_PROVIDER=openai. Kept on the server, never sent to browsers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# How long to wait for the AI before giving up (ms). CPU-only servers are slow.
AI_TIMEOUT_MS=180000
